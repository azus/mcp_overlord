<Window x:Class="mcp_overlord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        Title="{Binding WindowTitle}"
        Height="700"
        Width="1100"
        MinHeight="500"
        MinWidth="800"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Resources/Icons/app.ico">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="ServerCommands" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Command="{Binding ToggleServerCommand}" MinWidth="110">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/play.svg"
                                         Visibility="{Binding ShowStartIcon, Converter={StaticResource BoolToVisibility}}"/>
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/stop.svg"
                                         Visibility="{Binding ShowStopIcon, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding StartButtonText}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusText}"
                           ToolTip="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="96"
                           Margin="16,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Running">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Config">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Starting">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Command="{Binding ShowHelpCommand}" Margin="8,0,0,0" Style="{StaticResource ToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/help.svg"/>
                        <TextBlock Text="Help" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel x:Name="FileCommands" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NewConfigCommand}" Style="{StaticResource ToolbarButton}" ToolTip="New configuration">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/new.svg"/>
                        <TextBlock Text="New" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding LoadConfigCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Load configuration">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/folder.svg"/>
                        <TextBlock Text="Load" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveConfigCommand}" ToolTip="Save configuration">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/save.svg"/>
                        <TextBlock Text="Save" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveConfigAsCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Save configuration as">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/save_as.svg"/>
                        <TextBlock Text="Save as" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditServerSettingsCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Server settings">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/gear.svg"/>
                        <TextBlock Text="Settings" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CheckConnectionCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Check HTTP and HTTPS endpoints">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/network_check.svg"/>
                        <TextBlock Text="Check connection" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RestartAsAdministratorCommand}"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="Stop, then start this program elevated"
                        Visibility="{Binding ShowRestartAsAdministrator, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/Resources/Icons/shield.svg"/>
                        <TextBlock Text="Restart as Administrator" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ConfigPathDisplay}"
                           ToolTip="{Binding ConfigPath}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="●" Style="{StaticResource DirtyIndicator}"/>
                    <TextBlock Text="Unsaved changes" Style="{StaticResource DirtyIndicator}"/>
                </StackPanel>
            </Grid>
            </Grid>
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding EndpointNote}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ItemsControl ItemsSource="{Binding Endpoints}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Url}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>
                                <Button Margin="8,0,0,0" Padding="8,4" Background="{StaticResource RaisedBrush}"
                                        Command="{Binding DataContext.CopyEndpointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Url}">
                                    <StackPanel Orientation="Horizontal">
                                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Source="pack://application:,,,/Resources/Icons/copy.svg"/>
                                        <TextBlock Text="Copy" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource WarningBrush}" Text="{Binding ListenerPendingText}"
                       Visibility="{Binding ListenerSettingsPending, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ApplicationsColumn" Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="12,0,0,12">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Applications" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Command="{Binding AddApplicationCommand}" Style="{StaticResource IconButton}" ToolTip="Add application">
                            <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                             Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                             Source="pack://application:,,,/Resources/Icons/add.svg"/>
                        </Button>
                        <Button Command="{Binding EditApplicationCommand}" Style="{StaticResource IconButton}" ToolTip="Edit application">
                            <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                             Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                             Source="pack://application:,,,/Resources/Icons/pencil.svg"/>
                        </Button>
                        <Button Command="{Binding DuplicateApplicationCommand}" Style="{StaticResource IconButton}" ToolTip="Duplicate application">
                            <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                             Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                             Source="pack://application:,,,/Resources/Icons/duplicate.svg"/>
                        </Button>
                        <Button Command="{Binding RemoveApplicationCommand}" Style="{StaticResource IconButton}" ToolTip="Remove application">
                            <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                             Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                             Source="pack://application:,,,/Resources/Icons/remove.svg"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ListBox ItemsSource="{Binding Applications}"
                             SelectedItem="{Binding SelectedApplication}"
                             MouseDoubleClick="OnApplicationsDoubleClick"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Edit application"
                                            Command="{Binding DataContext.EditApplicationRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Source="pack://application:,,,/Resources/Icons/pencil.svg"/>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding RunningText}" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="2" Margin="0,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LogRow" Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="BottomPanelRow" Height="300"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding ClearLogCommand}" Background="{StaticResource RaisedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Source="pack://application:,,,/Resources/Icons/clear.svg"/>
                                <TextBlock Text="Clear" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <ComboBox DockPanel.Dock="Right" Width="120" Margin="0,0,8,0"
                                  ItemsSource="{Binding LevelFilters}"
                                  SelectedItem="{Binding SelectedLevelFilter}"/>
                        <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="LogGrid"
                              ItemsSource="{Binding LogRows}"
                              SelectedItem="{Binding SelectedLogRow}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Sorting="OnLogSorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="120" SortMemberPath="Timestamp"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" SortMemberPath="Level"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" SortMemberPath="Message"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <TabControl Grid.Row="2"
                            Style="{StaticResource BottomTabControl}"
                            SelectedIndex="{Binding BottomPanelTabIndex, Mode=TwoWay}">
                    <TabItem Header="Detail">
                    <DockPanel DataContext="{Binding Detail}">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Select a log line to see the full detail."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4"
                                   Visibility="{Binding HasRow, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ScrollViewer x:Name="DetailScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      SizeChanged="OnDetailScrollViewerSizeChanged"
                                      Visibility="{Binding HasRow, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding NetworkNote}"
                                           Foreground="{StaticResource WarningBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"
                                           Visibility="{Binding NetworkNote, Converter={StaticResource StringToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="Copy"
                                                        Margin="4,0,0,0"
                                                        Visibility="{Binding Value, Converter={StaticResource StringToVisibility}}"
                                                        Command="{Binding DataContext.Detail.CopyTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Value}">
                                                    <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                     Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                     Source="pack://application:,,,/Resources/Icons/copy.svg"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                            Visibility="{Binding ShowBody, Converter={StaticResource BoolToVisibility}}">
                                    <RadioButton Content="JSON" GroupName="DetailBody"
                                                 IsChecked="{Binding BodyView, Mode=TwoWay, Converter={StaticResource BodyViewEquals}, ConverterParameter=Json}"/>
                                    <RadioButton Content="Hex" GroupName="DetailBody"
                                                 IsChecked="{Binding BodyView, Mode=TwoWay, Converter={StaticResource BodyViewEquals}, ConverterParameter=Hex}"/>
                                    <RadioButton Content="ASCII" GroupName="DetailBody"
                                                 IsChecked="{Binding BodyView, Mode=TwoWay, Converter={StaticResource BodyViewEquals}, ConverterParameter=Ascii}"/>
                                </StackPanel>
                                <TabControl SelectedIndex="{Binding TabIndex, Mode=TwoWay}">
                                    <TabControl.Resources>
                                        <DataTemplate x:Key="LogBodyTemplate">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ActiveHeaders}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,4"
                                                           Visibility="{Binding ActiveHeaders, Converter={StaticResource StringToVisibility}}"/>
                                                <TextBlock Text="{Binding ActiveNote}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,4"
                                                           Visibility="{Binding ActiveNote, Converter={StaticResource StringToVisibility}}"/>
                                                <TextBox Text="{Binding ActiveJson, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="NoWrap"
                                                         FontFamily="Cascadia Mono, Consolas"
                                                         VerticalAlignment="Top"
                                                         HorizontalAlignment="Stretch"
                                                         MaxHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource PositiveLength}}"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         PreviewMouseWheel="OnDetailBodyPreviewMouseWheel"
                                                         Visibility="{Binding ShowJson, Converter={StaticResource BoolToVisibility}}"/>
                                                <ListBox ItemsSource="{Binding ActiveHexLines}"
                                                         Tag="DetailBody"
                                                         FontFamily="Cascadia Mono, Consolas"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         VerticalAlignment="Top"
                                                         HorizontalAlignment="Stretch"
                                                         Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource PositiveLength}}"
                                                         MaxHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource PositiveLength}}"
                                                         VirtualizingPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                                         ScrollViewer.CanContentScroll="True"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                         Loaded="OnDetailBodyLoaded"
                                                         IsVisibleChanged="OnDetailBodyVisibleChanged"
                                                         PreviewMouseWheel="OnDetailBodyPreviewMouseWheel"
                                                         Visibility="{Binding ShowHex, Converter={StaticResource BoolToVisibility}}"/>
                                                <ListBox ItemsSource="{Binding ActiveTextLines}"
                                                         Tag="DetailBody"
                                                         FontFamily="Cascadia Mono, Consolas"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         VerticalAlignment="Top"
                                                         HorizontalAlignment="Stretch"
                                                         Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource PositiveLength}}"
                                                         MaxHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource PositiveLength}}"
                                                         VirtualizingPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                                         ScrollViewer.CanContentScroll="True"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                         Loaded="OnDetailBodyLoaded"
                                                         IsVisibleChanged="OnDetailBodyVisibleChanged"
                                                         PreviewMouseWheel="OnDetailBodyPreviewMouseWheel"
                                                         Visibility="{Binding ShowAscii, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </TabControl.Resources>
                                    <TabItem Header="Request" Content="{Binding}" ContentTemplate="{StaticResource LogBodyTemplate}"/>
                                    <TabItem Header="Response" Content="{Binding}" ContentTemplate="{StaticResource LogBodyTemplate}"/>
                                    <TabItem Header="Image">
                                        <StackPanel>
                                            <TextBlock Text="This line has no image."
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Visibility="{Binding HasImages, Converter={StaticResource InverseBoolToVisibility}}"/>
                                            <ListBox ItemsSource="{Binding Images}"
                                                     SelectedItem="{Binding SelectedImage}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibility}}">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.Template>
                                                    <ControlTemplate TargetType="ListBox">
                                                        <ItemsPresenter/>
                                                    </ControlTemplate>
                                                </ListBox.Template>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,4">
                                                            <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                            <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="280"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Content="Save image"
                                                    Command="{Binding SaveImageCommand}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                    </TabItem>
                    <TabItem Header="Stats">
                        <StackPanel>
                            <TextBlock>
                                <Run Text="Uptime "/><Run Text="{Binding UptimeText, Mode=OneWay}"/>
                                <Run Text="    Requests "/><Run Text="{Binding RequestsText, Mode=OneWay}"/>
                                <Run Text="    Errors "/><Run Text="{Binding ErrorsText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="Last "/><Run Text="{Binding LastLatencyText, Mode=OneWay}"/>
                                <Run Text="    Average "/><Run Text="{Binding AverageLatencyText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="Screenshots "/><Run Text="{Binding ScreenshotsText, Mode=OneWay}"/>
                                <Run Text="    Bytes "/><Run Text="{Binding BytesText, Mode=OneWay}"/>
                                <Run Text="    Inputs "/><Run Text="{Binding InputsText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="Sessions "/><Run Text="{Binding SessionsText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PerToolText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Help">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding HelpText}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}"/>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

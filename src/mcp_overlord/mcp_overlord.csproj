  <Target Name="BuildSnapEncoder" BeforeTargets="BeforeBuild" Inputs="$(MSBuildThisFileDirectory)Native\snap.cpp;$(MSBuildThisFileDirectory)Native\fpng.cpp;$(MSBuildThisFileDirectory)Native\fpng.h;$(MSBuildThisFileDirectory)Native\build-snapenc.cmd" Outputs="$(MSBuildThisFileDirectory)Native\win-x64\snapenc.dll">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)Native\build-snapenc.cmd&quot;" />
  </Target>

  <Target Name="CopySnapEncoder" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Native\win-x64\snapenc.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildThisFileDirectory)Native\win-x64\snapenc.dll')" />
  </Target>

  <Target Name="CopySnapEncoderPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Native\win-x64\snapenc.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildThisFileDirectory)Native\win-x64\snapenc.dll')" />
  </Target>

</Project>

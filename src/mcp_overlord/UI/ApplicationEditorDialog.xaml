<Window x:Class="mcp_overlord.UI.ApplicationEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        Title="{Binding DialogTitle}"
        Width="720"
        Height="680"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Icon="pack://application:,,,/mcp_overlord;component/Resources/Icons/app.ico"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0"/>
            <Button Content="OK" Click="OnOk" IsDefault="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="DropZone" Grid.Column="0" MinHeight="48" Margin="0,0,8,0">
                        <Rectangle Style="{StaticResource DropZoneOutline}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12">
                            <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                             Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                             Source="pack://application:,,,/mcp_overlord;component/Resources/Icons/drop.svg"/>
                            <TextBlock Text="Drop a shortcut (.lnk) or an application (.exe) here" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="FinderTargetHost"
                            Grid.Column="1"
                            Style="{StaticResource FinderTarget}"
                            Width="{Binding ActualHeight, ElementName=DropZone}"
                            Height="{Binding ActualHeight, ElementName=DropZone}"
                            ClipToBounds="True"
                            VerticalAlignment="Center"
                            ToolTip="Drag onto a window to read its title, executable, and process"
                            PreviewMouseLeftButtonDown="OnFinderPressed">
                        <Viewbox Stretch="Uniform">
                            <svgc:SvgViewbox Stretch="Uniform"
                                             Source="pack://application:,,,/mcp_overlord;component/Resources/Icons/target.svg"
                                             Visibility="{Binding FinderActive, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </Viewbox>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding FinderPreview}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding DropStatus}"
                           Foreground="{StaticResource SuccessBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding DropStatus, Converter={StaticResource StringToVisibility}}"/>
                <TextBlock Text="A checked field is saved, even when it is empty. An empty optional field is treated as not set."
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Required" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding NameError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding NameError, Converter={StaticResource StringToVisibility}}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Required" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Executable" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    <Button Grid.Row="2" Grid.Column="3" Click="OnBrowseExecutable" Style="{StaticResource IconButton}" ToolTip="Browse for an executable" Margin="8,0,0,0">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/mcp_overlord;component/Resources/Icons/folder.svg"/>
                    </Button>
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ExecutableError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding ExecutableError, Converter={StaticResource StringToVisibility}}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Required" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Window title" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding WindowTitleError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding WindowTitleError, Converter={StaticResource StringToVisibility}}"/>

                    <CheckBox Grid.Row="6" Grid.Column="0" Content="Save" IsChecked="{Binding IncludeParameters}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Parameters" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2"
                             Text="{Binding Parameters, UpdateSourceTrigger=PropertyChanged}"
                             Opacity="{Binding IncludeParameters, Converter={StaticResource IncludeOpacity}}"/>

                    <CheckBox Grid.Row="7" Grid.Column="0" Content="Save" IsChecked="{Binding IncludeWorkingDirectory}"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Working directory" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
                             Opacity="{Binding IncludeWorkingDirectory, Converter={StaticResource IncludeOpacity}}"/>
                    <Button Grid.Row="7" Grid.Column="3" Click="OnBrowseWorkingDirectory" Style="{StaticResource IconButton}" ToolTip="Browse for a folder" Margin="8,0,0,0">
                        <svgc:SvgViewbox Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Source="pack://application:,,,/mcp_overlord;component/Resources/Icons/folder.svg"/>
                    </Button>

                    <CheckBox Grid.Row="8" Grid.Column="0" Content="Save" IsChecked="{Binding IncludeProcessName}"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Process name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2"
                             Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                             Opacity="{Binding IncludeProcessName, Converter={StaticResource IncludeOpacity}}"/>

                    <CheckBox Grid.Row="9" Grid.Column="0" Content="Save" IsChecked="{Binding IncludeDescription}"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="Description" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="9" Grid.Column="2" Grid.ColumnSpan="2"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="56"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Opacity="{Binding IncludeDescription, Converter={StaticResource IncludeOpacity}}"/>

                    <CheckBox Grid.Row="10" Grid.Column="0" Content="Save" IsChecked="{Binding IncludeClickBackend}"/>
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="Click backend" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="2"
                              ItemsSource="{Binding ClickBackendChoices}"
                              SelectedItem="{Binding ClickBackendName}"
                              Opacity="{Binding IncludeClickBackend, Converter={StaticResource IncludeOpacity}}"/>
                </Grid>
                <TextBlock Text="{Binding FormError}" Style="{StaticResource FieldError}" Margin="0,8,0,0"
                           Visibility="{Binding FormError, Converter={StaticResource StringToVisibility}}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
